includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - phpstan-baseline.neon

parameters:
    level: 9
    paths:
        - arkid-catalogue-link.php
        - includes
        - uninstall.php
    bootstrapFiles:
        - phpstan-bootstrap.php
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
        - vendor/php-stubs/woocommerce-stubs/woocommerce-packages-stubs.php
    excludePaths:
        - vendor
        - node_modules (?)
        - build (?)
        - tests
    ignoreErrors:
        # build/*.asset.php is generated by `npm run build`, so it is absent
        # wherever PHPStan runs without Node — the static analysis job, and any
        # fresh checkout. Both requires are already guarded by file_exists() at
        # runtime; PHPStan resolves the literal path anyway and reports a file
        # it cannot know is generated. reportUnmatched stops that from failing
        # the other way round on a tree that HAS been built.
        -
            identifier: require.fileNotFound
            paths:
                - includes/Admin/Assets.php
                - includes/Frontend/Assets.php
            reportUnmatched: false
    treatPhpDocTypesAsCertain: true
    reportUnmatchedIgnoredErrors: true
    checkMissingCallableSignature: true
    checkUninitializedProperties: true
    checkBenevolentUnionTypes: true
