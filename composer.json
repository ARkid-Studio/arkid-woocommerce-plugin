{
	"name": "arkid/arkid-catalogue-link",
	"description": "Link products in your WooCommerce store with the ARkid catalogue.",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/woocommerce-stubs": "^11.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^2.2",
		"phpstan/phpstan-deprecation-rules": "^2.0",
		"phpstan/phpstan-strict-rules": "^2.0",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"woocommerce/qit-cli": "^1.3",
		"wp-coding-standards/wpcs": "^3.4",
		"wp-phpunit/wp-phpunit": "^7.0",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"Arkid\\CatalogueLink\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Arkid\\CatalogueLink\\Tests\\": "tests/phpunit/",
			"Arkid\\CatalogueLink\\Tests\\Integration\\": "tests/integration/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true,
		"platform": {
			"php": "8.1"
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"test": "phpunit",
		"test:integration": "phpunit -c phpunit-integration.xml.dist",
		"test:contract": "phpunit -c phpunit-integration.xml.dist --group live-api",
		"test:all": [
			"@test",
			"@test:integration"
		]
	}
}
