{
	"name": "arkid-catalogue-link",
	"version": "1.0.0",
	"description": "Link products in your WooCommerce store with the ARkid catalogue.",
	"license": "GPL-3.0-or-later",
	"private": true,
	"scripts": {
		"dev": "npm run build && npm run dev:up && npm run start",
		"start": "wp-scripts start --blocks-manifest",
		"build": "wp-scripts build --blocks-manifest",
		"plugin-zip": "bash bin/build-plugin-zip.sh",
		"postinstall": "composer install",
		"dev:up": "bash bin/dc.sh up -d && bash bin/dc.sh exec -T -u www-data wordpress bash /workspaces/arkid-woocommerce-plugin/.devcontainer/provision.sh",
		"dev:down": "bash bin/dc.sh down",
		"dev:reset": "bash bin/dc.sh down -v",
		"dev:logs": "bash bin/dc.sh logs -f",
		"cli": "wp --path=/var/www/html",
		"lint:js": "wp-scripts lint-js --max-warnings=0",
		"lint:css": "wp-scripts lint-style",
		"lint:php": "composer lint",
		"format": "wp-scripts format",
		"test:js": "wp-scripts test-unit-js --config jest.config.js",
		"test:php": "composer test",
		"check:php": "composer phpstan && composer lint && composer test && composer test:integration",
		"check:js": "npm run lint:js && npm run lint:css",
		"check": "npm run check:php && npm run check:js",
		"release": "npm run check && npm run plugin-zip",
		"packages-update": "wp-scripts packages-update",
		"makepot": "wp i18n make-pot . languages/arkid-catalogue-link.pot --exclude=src,bin,tests,node_modules,vendor,languages,assets",
		"test:php:setup": "bash bin/install-wp-tests.sh",
		"test:php:integration": "composer test:integration",
		"test:e2e": "dotenvx run --quiet -- playwright test",
		"test:e2e:ui": "dotenvx run --quiet -- playwright test --ui",
		"e2e:install": "playwright install chromium",
		"test:contract": "dotenvx run --quiet -- composer test:contract",
		"env:set": "dotenvx set",
		"env:decrypt": "dotenvx get"
	},
	"devDependencies": {
		"@dotenvx/dotenvx": "2.30.0",
		"@playwright/test": "^1.63.0",
		"@woocommerce/dependency-extraction-webpack-plugin": "^3.0.1",
		"@woocommerce/eslint-plugin": "^2.3.0",
		"@wordpress/prettier-config": "^4.56.0",
		"@wordpress/scripts": "^30.0.0"
	}
}
